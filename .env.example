# === DATABASE ===
DATABASE_URL=sqlite:///./solo_dev.db
# Production: DATABASE_URL=postgresql://user:pass@host:5432/dbname

# === REDIS ===
REDIS_URL=redis://localhost:6379
# Production: get from Railway, Render, or use Upstash

# === AUTH ===
SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token-hex-32
ENV=development
# Set ENV=production on deployment platform

# === AI ===
OPENAI_API_KEY=sk-your-openai-key-here

# === MONITORING ===
SENTRY_DSN=
# Get from sentry.io - create free account, create Python project, copy DSN
LOG_LEVEL=INFO
# DEBUG for development, INFO for production

# === SECURITY ===
ALLOWED_HOSTS=*
# Production: ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
